# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and must never be committed.

# Supabase → Project Settings → API Keys (or the "Connect" button)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The publishable key (sb_publishable_...) or the legacy "anon public" key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used from Phase 4 for creating users and setting passwords.
# The secret key (sb_secret_...) or the legacy "service_role" key.
SUPABASE_SERVICE_ROLE_KEY=

# Used only by the local scripts (npm run db:migrate / db:test).
# Supabase → Connect → "Session pooler" connection string, pasted as-is.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres
# Your database password (fills in [YOUR-PASSWORD] above)
SUPABASE_DB_PASSWORD=
